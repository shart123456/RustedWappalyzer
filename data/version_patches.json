    "meta": {
      "generator": "Foswiki[-/ ]([\\d.]+)\\;version:\\1"
    }
  },
  "GoAhead": {
    "headers": {
      "Server": "GoAhead(?:-Webs)?/([\\d.]+)\\;version:\\1"
    }
  },
  "HCL Domino": {
    "headers": {
      "Server": "Lotus-Domino/([\\d.]+)\\;version:\\1"
    }
  },
  "Ktor": {
    "headers": {
      "server": "^[Kk]tor/([\\d.]+)\\;version:\\1",
      "x-engine": "^[Kk]tor[/ ]([\\d.]+)\\;version:\\1"
    }
  },
  "Magnolia CMS": {
    "meta": {
      "generator": "Magnolia[^,]*,version=([\\d.]+)\\;version:\\1"
    }
  },
  "Mastodon": {
    "meta": {
      "generator": "Mastodon v?([\\d.]+)\\;version:\\1"
    }
  },
  "OpenBSD httpd": {
    "headers": {
      "Server": "^OpenBSD httpd/([\\d.]+)\\;version:\\1"
    }
  },
  "OpenCms": {
    "headers": {
      "Server": "OpenCms/([\\d.]+)\\;version:\\1"
    }
  },
  "Piwigo": {
    "meta": {
      "generator": "Piwigo ([\\d.]+)\\;version:\\1"
    }
  },
  "PrestaShop": {
    "js": {
      "prestashop.version": "(.+)\\;version:\\1"
    }
  },
  "ProcessWire": {
    "meta": {
      "generator": "ProcessWire ([\\d.]+)\\;version:\\1"
    }
  },
  "Shiny": {
    "headers": {
      "x-powered-by": "Shiny Server(?:\\s+Pro)?/([\\d.]+)\\;version:\\1"
    }
  },
  "Statamic": {
    "headers": {
      "x-powered-by": "^Statamic[/ ]([\\d.]+)\\;version:\\1"
    }
  },
  "Web2py": {
    "meta": {
      "web2py_version": "^([\\d.]+)\\;version:\\1"
    }
