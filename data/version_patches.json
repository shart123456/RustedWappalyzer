{
  "Apache JSPWiki": {
    "meta": {
      "generator": "JSPWiki v([\\d.]+)\\;version:\\1"
    }
  },
  "Apache Wicket": {
    "js": {
      "Wicket.Version": "(.+)\\;version:\\1"
    }
  },
  "CKAN": {
    "headers": {
      "x-ckan-version": "^([\\d.]+)\\;version:\\1"
    },
    "js": {
      "ckan.CKAN_VERSION": "(.+)\\;version:\\1"
    }
  },
  "Craft CMS": {
    "meta": {
      "generator": "Craft CMS ([\\d.]+)\\;version:\\1"
    }
  },
  "DSpace": {
    "meta": {
      "generator": "DSpace ([\\d.]+)\\;version:\\1"
    }
  },
  "Dotclear": {
    "meta": {
      "generator": "Dotclear ([\\d.]+)\\;version:\\1"
    }
  },
  "ELOG HTTP": {
    "headers": {
      "Server": "^ELOG HTTP v([\\d.]+)\\;version:\\1"
    }
  },
  "EPrints": {
    "meta": {
      "generator": "EPrints ([\\d.]+)\\;version:\\1"
    }
  },
  "Etherpad": {
    "headers": {
      "Server": "^Etherpad[/ ]([\\d.]+)\\;version:\\1"
