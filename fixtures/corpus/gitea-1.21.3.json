bel data-tooltip-content=\"Enable federated avatar lookup using Libravatar.\">Enable Federated Avatars</label>\n\t\t\t\t\t\t\t\t<input name=\"enable_federated_avatar\" type=\"checkbox\" checked>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"inline field\">\n\t\t\t\t\t\t\t<div class=\"ui checkbox\" id=\"enable-openid-signin\">\n\t\t\t\t\t\t\t\t<label data-tooltip-content=\"Enable user sign-in via OpenID.\">Enable OpenID Sign-In</label>\n\t\t\t\t\t\t\t\t<input name=\"enable_open_id_sign_in\" type=\"checkbox\" checked>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"inline field\">\n\t\t\t\t\t\t\t<div class=\"ui checkbox\" id=\"disable-registration\">\n\t\t\t\t\t\t\t\t<label data-tooltip-content=\"Disable user self-registration. Only administrators will be able to create new user accounts.\">Disable Self-Registration</label>\n\t\t\t\t\t\t\t\t<input name=\"disable_registration\" type=\"checkbox\" >\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"inline field\">\n\t\t\t\t\t\t\t<div class=\"ui checkbox\" id=\"allow-only-external-registration\">\n\t\t\t\t\t\t\t\t<label data-tooltip-content=\"Allow Registration Only Through External Services\">Allow Registration Only Through External Services</label>\n\t\t\t\t\t\t\t\t<input name=\"allow_only_external_registration\" type=\"checkbox\" >\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"inline field\">\n\t\t\t\t\t\t\t<div class=\"ui checkbox\" id=\"enable-openid-signup\">\n\t\t\t\t\t\t\t\t<label data-tooltip-content=\"Enable OpenID-based user self-registration.\">Enable OpenID Self-Registration</label>\n\t\t\t\t\t\t\t\t<input name=\"enable_open_id_sign_up\" type=\"checkbox\" checked>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t<div class=\"inline field\">\n\t\t\t\t\t\t\t<div class=\"ui checkbox\" id=\"enable-captcha\">\n\t\t\t\t\t\t\t\t<label data-tooltip-content=\"Require a CAPTCHA for user self-registration.\">Enable registration CAPTC